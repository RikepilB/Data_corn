# Copiar a .env (no se sube al repositorio).
# Clave de Google Maps Platform con "Map Tiles API" habilitada, restringida por referente HTTP.
# Sin clave, la web usa Sentinel-2 cloudless (EOX) como imagen satelital.
PUBLIC_GOOGLE_MAPS_KEY=

# Asistente de chat (SI). Solo en el servidor: la clave nunca llega al navegador.
OPENROUTER_API_KEY=
# Modelo de OpenRouter; vacío usa el de server/chat/openrouter.ts.
OPENROUTER_MODEL=
# De dónde lee el servidor los reportes precalculados. Vacío: http://localhost:4321 en local, el sitio en Vercel.
CHAT_SITE_ORIGIN=
# Muestra el panel de chat en el reporte de ejemplo. Apagado por defecto.
PUBLIC_CHAT_ENABLED=false
